# Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml for local development
# Or enter these fields into Streamlit Cloud -> Settings -> Secrets

[mysql]
host = "localhost"
port = 3306
user = "durga"
password = "durga123"
database = "imdb_sentiment_db"
connect_timeout = 5

